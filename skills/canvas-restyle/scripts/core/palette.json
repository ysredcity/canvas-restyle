{
  "name": "default",
  "_note": "默认语义色板。family 由原图颜色的色相归类得到；soft = 浅底卡片，solid = 深底（白字），white = 白卡，accent = 中等饱和的强调色（PPT 等以饱和色作强调的场景，飞书引擎不使用）。改这里会影响所有默认重绘结果。",
  "page_bg": null,
  "ink": "#1f2937",
  "heading": "#0f172a",
  "muted": "#64748b",
  "container": {"bg": "#f6f9fc", "alt_bg": "#ffffff", "border": "#dbe3ec"},
  "connector": "#8aa0c4",
  "grid": "#e5eaf0",
  "radius": {"card": 8, "container": 12, "small": 6},
  "families": {
    "neutral": {"accent": {"bg": "#8c96a3", "border": "#6b7684", "text": "#ffffff"},
               "white": {"bg": "#ffffff", "border": "#d5dde7", "text": "#334155"},
                "soft":  {"bg": "#f4f6f9", "border": "#d5dde7", "text": "#334155"},
                "solid": {"bg": "#475569", "border": "#334155", "text": "#ffffff"}},
    "teal":    {"accent": {"bg": "#14a39a", "border": "#0f857d", "text": "#ffffff"},
               "soft":  {"bg": "#ecf8f6", "border": "#8fd0c7", "text": "#0f5f5a"},
                "solid": {"bg": "#137a72", "border": "#0f5f5a", "text": "#ffffff"}},
    "blue":    {"accent": {"bg": "#3b6fd8", "border": "#2c56b0", "text": "#ffffff"},
